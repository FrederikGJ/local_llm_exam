# Kopiér til .env og ret her. Uden .env bruges standardværdierne nedenfor.

# Modellen fra https://ollama.com/library. Standard = den mindste Qwen (Qwen1.5 0.5B chat, 2-bit, ~300 MB).
OLLAMA_MODEL=qwen:0.5b-chat-v1.5-q2_K

# Embeddingmodel til RAG (rag/ingest.py og experiments/experiment_rag/). Flersproget, ~1,2 GB.
EMBED_MODEL=bge-m3

# Navnet RAG-appen kalder. Peger altid på OLLAMA_MODEL med parametrene herunder.
LLM_ALIAS=rag-llm
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096

OLLAMA_PORT=11434
OLLAMA_VERSION=0.40.13
OLLAMA_KEEP_ALIVE=10m
